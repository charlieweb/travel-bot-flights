# Backend Environment Configuration
# Copy this file to .env and fill in your actual values

# Scraping Provider Selection
# Options: firecrawl, crawl4ai, spider
# - firecrawl: Cloud API (requires API key, good JS rendering)
# - crawl4ai: Self-hosted (runs in Docker, basic JS support)
# - spider: Cloud API (excellent JS rendering, free credits)
SCRAPING_PROVIDER=spider

# Firecrawl Configuration (cloud provider)
# Get your API key at: https://firecrawl.dev
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2

# Crawl4AI Configuration (self-hosted)
# Base URL for Crawl4AI service (internal Docker network)
# When running in Docker, use: http://crawl4ai:11235
CRAWL4AI_BASE_URL=http://localhost:11235
CRAWL4AI_API_TOKEN=optional_token_if_configured

# Spider Cloud Configuration (cloud provider)
# Get free API key at: https://spider.cloud/dashboard
# No credit card required, free credits on signup
SPIDER_API_KEY=your_spider_api_key_here

# AirLabs Configuration (optional)
# Get your API key at: https://airlabs.co
# Used for airport data lookups
AIRLABS_API_KEY=your_airlabs_api_key_here