# Backend Environment Configuration
# Copy this file to .env and fill in your actual values

# Scraping Provider Selection
# Options: spider, playwright
# - spider: Cloud API (excellent JS rendering, free credits)
# - playwright: Local browser automation (requires Playwright server)
SCRAPING_PROVIDER=spider

# Spider Cloud Configuration (cloud provider)
# Get free API key at: https://spider.cloud/dashboard
# No credit card required, free credits on signup
SPIDER_API_KEY=your_spider_api_key_here
SPIDER_BASE_URL=https://api.spider.cloud

# Playwright Configuration (local browser)
# URL for Playwright CDP (Chrome DevTools Protocol)
# Run: npx playwright install && npx playwright start
PLAYWRIGHT_CDP_URL=http://localhost:9222
# Required once for playwright provider: uv run playwright install chromium

# Google GenAI Configuration (optional, recommended)
# Get your API key at: https://aistudio.google.com/apikey
# Used for AI-powered flight data parsing from scraped pages
# Dramatically improves extraction quality vs regex-only parsing
GOOGLE_API_KEY=your_google_api_key_here
# Optional model override (default: gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.1-flash-lite

# LLM provider for natural-language search parsing
# Options: gemini (implemented); openai / anthropic (planned)
# Selects the API key env var automatically (GOOGLE_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY)
LLM_PROVIDER=gemini
# Optional model override for search parsing (defaults to a cheap small model per provider;
# falls back to GEMINI_MODEL when unset and provider is gemini)
# LLM_MODEL=

# AirLabs Configuration (optional / legacy)
# Airport search now uses local data/airports.json (no API call).
# Keep this only if you still run the old AirLabs client elsewhere.
# AIRLABS_API_KEY=your_airlabs_api_key_here

# CORS (comma-separated origins allowed by the API)
# Include local Nuxt and any deployed frontend URL
CORS_ALLOW_ORIGINS=http://localhost:3000,https://frontend-production-6d6e.up.railway.app