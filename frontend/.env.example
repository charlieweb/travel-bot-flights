# Nuxt API Configuration

# Use http://localhost:8000 for local development (outside Docker)
# Use http://backend:8000 when running inside Docker containers

# Client-side (browser) - Airport component uses this
NUXT_PUBLIC_API_BASE=http://localhost:8000

# Server-side (SSR in Docker) - Search route uses this
NUXT_INTERNAL_API_BASE=http://backend:8000