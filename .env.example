# Travel Bot Environment Configuration
# Copy this file to .env and fill in your actual values

# Frontend Configuration
# Copy frontend/.env.example to frontend/.env and configure there

# Scraping Provider Selection
# Options: firecrawl, crawl4ai, spider, playwright
SCRAPING_PROVIDER=firecrawl

# Firecrawl Configuration
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2

# Crawl4AI Configuration
CRAWL4AI_API_TOKEN=optional_token_here
CRAWL4AI_BASE_URL=http://crawl4ai:11235

# Spider Cloud Configuration
SPIDER_API_KEY=your_spider_api_key_here

# Playwright Configuration (for local/stealth scraping)
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_CDP_URL=http://localhost:9222